#!/usr/bin/osascript -l JavaScript
// Manual two-sided printing for printers without duplex: prints the fronts, asks you to
// flip the stack, then prints the backs. Works as a CLI (epson-duplex file.pdf) and as a
// print dialog PDF Service (macOS passes title, options, path).
//
// The printer stacks output face up and feeds the top sheet of the rear tray, and turning
// the stack over reverses it. So both passes print in ascending order: the backs start on
// page 1's sheet, and turning the finished stack over puts page 1 on top. An odd page
// count gets a blank last back.

ObjC.import('Cocoa')
ObjC.import('PDFKit')

const QUEUE = env('EPSON_QUEUE') || 'EPSON_ET_2710_arm64'
const DRY_RUN = env('EPSON_DUPLEX_DRY_RUN') === '1'

/** Read an environment variable, or '' when unset. */
function env(name) {
	const v = $.NSProcessInfo.processInfo.environment.objectForKey(name)
	return v.isNil() ? '' : v.js
}

/** Build a PDF from 1-based page numbers of src; 0 means a blank page. */
function buildPdf(src, pages, path) {
	const out = $.PDFDocument.alloc.init
	const box = src.pageAtIndex(0).boundsForBox($.kPDFDisplayBoxMediaBox)
	pages.forEach((n, i) => {
		let page
		if (n === 0) {
			page = $.PDFPage.alloc.init
			page.setBoundsForBox(box, $.kPDFDisplayBoxMediaBox)
		} else {
			page = src.pageAtIndex(n - 1).copy
		}
		out.insertPageAtIndex(page, i)
	})
	if (!out.writeToFile(path)) throw new Error('Cannot write ' + path)
}

/** Print a PDF in the order given, bypassing the queue's default reverse order. */
function print(app, path, title) {
	const cmd = `lp -d ${q(QUEUE)} -t ${q(title)} -o outputorder=normal ${q(path)}`
	if (DRY_RUN) console.log(cmd)
	else app.doShellScript(cmd)
}

/** Quote a string for the shell. */
function q(s) {
	return "'" + String(s).replace(/'/g, "'\\''") + "'"
}

/** Odd pages and even pages (padded with a blank) in print order. */
function plan(count) {
	const fronts = []
	const backs = []
	for (let n = 1; n <= count; n++) (n % 2 ? fronts : backs).push(n)
	if (count % 2) backs.push(0)
	return { fronts, backs }
}

/** Show how to reload the stack; true when the user clicks Print Backs. */
function askForBacks(sheets) {
	$.NSApplication.sharedApplication
	$.NSApp.setActivationPolicy($.NSApplicationActivationPolicyAccessory)
	const alert = $.NSAlert.alloc.init
	alert.icon = $.NSImage.imageWithSystemSymbolNameAccessibilityDescription('printer.fill', 'Printer')
	alert.messageText = 'Turn the pages over for the back side'
	alert.informativeText =
		`1. Wait until ${sheets > 1 ? `all ${sheets} sheets have` : 'the sheet has'} come out.\n` +
		'2. Take the whole stack without changing its order.\n' +
		'3. Follow the pictures below, then click Print Backs.\n\n' +
		'When the backs finish, turn the whole stack over: page 1 is on top.'
	alert.addButtonWithTitle('Print Backs')
	alert.addButtonWithTitle('Cancel')
	const view = $.NSImageView.alloc.initWithFrame($.NSMakeRect(0, 0, 538, 210))
	view.image = diagram()
	alert.accessoryView = view
	$.NSApp.activateIgnoringOtherApps(true)
	return alert.runModal === $.NSAlertFirstButtonReturn
}

/** Three-step picture: hold the top page readable, flip it over the top, load it in the rear tray. */
function diagram() {
	const P = 170, GAP = 14, W = P * 3 + GAP * 2, H = 210
	const img = $.NSImage.alloc.initWithSize($.NSMakeSize(W, H))
	// Resolve system colours for the current light or dark mode; the alert background is translucent.
	$.NSAppearance.currentAppearance = $.NSApp.effectiveAppearance
	img.lockFocus
	const ink = rgb(0.13, 0.13, 0.15), accent = $.NSColor.systemBlueColor, grey = rgb(0.55, 0.56, 0.6)
	const paper = rgb(1, 1, 1), label = $.NSColor.labelColor
	const card = label.colorWithAlphaComponent(0.06)

	const rect = (x, y, w, h, fill, stroke, r) => {
		const p = $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius($.NSMakeRect(x, y, w, h), r || 0, r || 0)
		if (fill) { fill.set; p.fill }
		if (stroke) { p.lineWidth = 1.5; stroke.set; p.stroke }
	}
	const text = (s, x, y, size, color, bold, width) => {
		const style = $.NSMutableParagraphStyle.alloc.init
		style.alignment = 1 // centred
		const attrs = $.NSMutableDictionary.dictionary
		attrs.setObjectForKey(bold ? $.NSFont.boldSystemFontOfSize(size) : $.NSFont.systemFontOfSize(size), $.NSFontAttributeName)
		attrs.setObjectForKey(color, $.NSForegroundColorAttributeName)
		attrs.setObjectForKey(style, $.NSParagraphStyleAttributeName)
		$(s).drawInRectWithAttributes($.NSMakeRect(x, y, width, size * 2.6), attrs)
	}
	const arrow = (pts, color, curve) => {
		const p = $.NSBezierPath.bezierPath
		p.moveToPoint($.NSMakePoint(pts[0][0], pts[0][1]))
		if (curve) p.curveToPointControlPoint1ControlPoint2($.NSMakePoint(pts[3][0], pts[3][1]),
			$.NSMakePoint(pts[1][0], pts[1][1]), $.NSMakePoint(pts[2][0], pts[2][1]))
		else p.lineToPoint($.NSMakePoint(pts[1][0], pts[1][1]))
		p.lineWidth = 3; p.lineCapStyle = 1; color.set; p.stroke
		const [ex, ey] = pts[pts.length - 1], [px, py] = pts[pts.length - 2]
		const n = Math.hypot(ex - px, ey - py), ux = (ex - px) / n, uy = (ey - py) / n, s = 10
		const h = $.NSBezierPath.bezierPath
		h.moveToPoint($.NSMakePoint(ex + ux * 4, ey + uy * 4))
		h.lineToPoint($.NSMakePoint(ex - ux * s - uy * s * 0.7, ey - uy * s + ux * s * 0.7))
		h.lineToPoint($.NSMakePoint(ex - ux * s + uy * s * 0.7, ey - uy * s - ux * s * 0.7))
		h.closePath; h.fill
	}
	// A sample printed page; seen through the paper (flipped over the top) it is faint and upside down.
	const sample = (x, y, w, h, throughPaper) => {
		const a = throughPaper ? 0.22 : 1
		const block = (rx, ry, rw, rh, color) => {
			const top = throughPaper ? y + ry * h : y + h - (ry + rh) * h
			rect(x + rx * w, top, rw * w, rh * h, color.colorWithAlphaComponent(a), null, 1.5)
		}
		block(0.12, 0.08, 0.6, 0.08, ink)
		block(0.12, 0.22, 0.34, 0.24, accent)
		for (let i = 0; i < 4; i++) block(0.52, 0.23 + i * 0.06, 0.36, 0.025, grey)
		for (let i = 0; i < 6; i++) block(0.12, 0.54 + i * 0.065, i === 5 ? 0.45 : 0.76, 0.025, grey)
	}
	const step = (n, x, caption) => {
		rect(x, 0, P, H, card, null, 12)
		text(String(n), x + 6, H - 42, 15, accent, true, 24)
		text(caption, x + 8, 4, 12, label, false, P - 16)
	}

	// 1. Hold the stack so you can read the page on top.
	let x = 0
	step(1, x, 'Hold the stack so you can read the top page')
	const pw = 74, ph = 104, py = 62
	rect(x + (P - pw) / 2, py, pw, ph, paper, grey)
	sample(x + (P - pw) / 2, py, pw, ph, false)

	// 2. Flip it over the top, so the top ends up at the bottom.
	x = P + GAP
	step(2, x, 'Flip it over the top, like a wall calendar')
	rect(x + (P - pw) / 2, py, pw, ph, paper, grey)
	sample(x + (P - pw) / 2, py, pw, ph, true)
	const cx = x + P / 2
	arrow([[cx - 30, py + ph + 8], [cx - 24, py + ph + 34], [cx + 34, py + ph + 34], [cx + 46, py + ph - 6]], accent, true)

	// 3. Load it in the rear tray: blank side facing you, top going in first.
	x = (P + GAP) * 2
	step(3, x, 'Load it in the rear tray, blank side facing you')
	rect(x + (P - 60) / 2, 92, 60, 84, paper, grey)         // sheet standing in the rear tray
	sample(x + (P - 60) / 2, 92, 60, 84, true)
	rect(x + 20, 46, P - 40, 56, label.colorWithAlphaComponent(0.12), label.colorWithAlphaComponent(0.7), 8) // printer body
	rect(x + 40, 54, P - 80, 6, label.colorWithAlphaComponent(0.7), null, 2) // output slot
	arrow([[x + P - 30, 172], [x + P - 30, 112]], accent, false)

	img.unlockFocus
	return img
}

/** An sRGB colour. */
function rgb(r, g, b) {
	return $.NSColor.colorWithSRGBRedGreenBlueAlpha(r, g, b, 1)
}

function run(argv) {
	const app = Application.currentApplication()
	app.includeStandardAdditions = true

	// PDF Services pass (title, options, path); the CLI passes just the path.
	const path = argv.length >= 3 ? argv[2] : argv[0]
	if (!path) return 'Usage: epson-duplex file.pdf'
	const title = argv.length >= 3 ? argv[0] : $(path).lastPathComponent.js

	const src = $.PDFDocument.alloc.initWithURL($.NSURL.fileURLWithPath(path))
	if (src.isNil()) throw new Error('Not a PDF: ' + path)
	const count = Number(src.pageCount)

	const tmp = $.NSTemporaryDirectory().js
	if (count === 1) {
		print(app, path, title)
		return 'Single page, printed one side'
	}

	const { fronts, backs } = plan(count)
	const frontPath = tmp + 'epson-duplex-front.pdf'
	const backPath = tmp + 'epson-duplex-back.pdf'
	buildPdf(src, fronts, frontPath)
	buildPdf(src, backs, backPath)
	if (DRY_RUN) console.log('fronts ' + fronts.join(',') + ' | backs ' + backs.join(','))

	print(app, frontPath, title + ' (fronts)')

	if (!DRY_RUN && !askForBacks(fronts.length)) return 'Cancelled after the fronts'

	print(app, backPath, title + ' (backs)')
	return 'Printed ' + count + ' pages on ' + fronts.length + ' sheets'
}
