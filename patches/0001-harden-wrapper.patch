+/* Copy a job option into a NAME_MAX field; fail instead of overflowing. */
+static int
+copy_option (char *dst, const char *src)
+{
+	if (strlen (src) > NAME_MAX)
+		return 1;
+	strcpy (dst, src);
 	return 0;
 }
 
 
+/* True if every char is safe to pass unquoted (or quoted, with spaces) to the shell. */
+static int
+is_shell_safe (const char *s, int allow_space)
+{
+	for (; *s; s ++)
+	{
+		if (!isalnum ((unsigned char) *s) && *s != '_' && *s != '.' && *s != '-'
+			&& !(allow_space && *s == ' '))
+			return 0;
+	}
+	return 1;
+}
